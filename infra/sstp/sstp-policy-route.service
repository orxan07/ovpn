[Unit]
Description=Ensure SSTP marked traffic reaches sing-box
After=sing-box.service sstp-singbox-route.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/ensure-sstp-policy-route
TimeoutStartSec=15
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
CapabilityBoundingSet=CAP_NET_ADMIN
RestrictAddressFamilies=AF_NETLINK AF_UNIX
