# Drop-in для /etc/sudoers.d/wg-admin-sstp (chmod 440)
#
# Даёт пользователю, под которым работает Node-сервер админки (по умолчанию root,
# но если ты переехал на отдельный sysuser — поменяй имя), право выполнять
# нужные для управления SSTP команды без пароля.
#
# Если админка крутится от root (сейчас — да), этот файл не нужен.
# Если переедешь на отдельный пользователь, например `wgadmin`:
#
#   sudo install -m 440 sudoers.example /etc/sudoers.d/wg-admin-sstp
#   sudo visudo -c    # проверить синтаксис
#
# и заменить ниже `wgadmin` на реальное имя.

wgadmin ALL=(root) NOPASSWD: /usr/sbin/accel-cmd *
wgadmin ALL=(root) NOPASSWD: /bin/cat /etc/accel-ppp/chap-secrets
wgadmin ALL=(root) NOPASSWD: /usr/bin/install -m 600 /tmp/sstp-secrets-* /etc/accel-ppp/chap-secrets
wgadmin ALL=(root) NOPASSWD: /bin/systemctl restart accel-ppp
wgadmin ALL=(root) NOPASSWD: /bin/systemctl restart sing-box
wgadmin ALL=(root) NOPASSWD: /bin/systemctl restart wg-quick@wg0
wgadmin ALL=(root) NOPASSWD: /bin/systemctl enable sing-box wg-quick@wg0 accel-ppp
wgadmin ALL=(root) NOPASSWD: /bin/systemctl disable --now openvpn openvpn@server openvpn-server@server openvpn-server
wgadmin ALL=(root) NOPASSWD: /bin/systemctl is-active accel-ppp
wgadmin ALL=(root) NOPASSWD: /bin/systemctl status accel-ppp *
wgadmin ALL=(root) NOPASSWD: /bin/systemctl show accel-ppp *
wgadmin ALL=(root) NOPASSWD: /bin/cat /etc/accel-ppp.conf
wgadmin ALL=(root) NOPASSWD: /usr/bin/test -f /var/log/accel-ppp/accel-ppp.log
wgadmin ALL=(root) NOPASSWD: /usr/bin/test -f /var/log/accel-ppp/auth-fail.log
wgadmin ALL=(root) NOPASSWD: /usr/bin/test -f /var/log/accel-ppp/core.log
wgadmin ALL=(root) NOPASSWD: /usr/bin/test -f /var/log/accel-ppp/emerg.log
wgadmin ALL=(root) NOPASSWD: /usr/bin/tail -n * /var/log/accel-ppp/accel-ppp.log
wgadmin ALL=(root) NOPASSWD: /usr/bin/tail -n * /var/log/accel-ppp/auth-fail.log
wgadmin ALL=(root) NOPASSWD: /usr/bin/tail -n * /var/log/accel-ppp/core.log
wgadmin ALL=(root) NOPASSWD: /usr/bin/tail -n * /var/log/accel-ppp/emerg.log
wgadmin ALL=(root) NOPASSWD: /usr/bin/ss *
wgadmin ALL=(root) NOPASSWD: /usr/bin/kill *
wgadmin ALL=(root) NOPASSWD: /usr/bin/journalctl -u accel-ppp *
wgadmin ALL=(root) NOPASSWD: /usr/bin/awk *
wgadmin ALL=(root) NOPASSWD: /usr/bin/openssl x509 *
wgadmin ALL=(root) NOPASSWD: /usr/bin/env bash /opt/wg-admin/infra/sstp/clear-logs.sh
wgadmin ALL=(root) NOPASSWD: /usr/bin/env bash /opt/wg-admin/scripts/clear-vpn-logs.sh
wgadmin ALL=(root) NOPASSWD: /usr/bin/env bash /opt/wg-admin/infra/sstp/firewall.sh
wgadmin ALL=(root) NOPASSWD: /usr/bin/iptables *
wgadmin ALL=(root) NOPASSWD: /usr/bin/install -m 644 /tmp/sstp-firewall-*.service /etc/systemd/system/sstp-firewall.service
wgadmin ALL=(root) NOPASSWD: /bin/systemctl daemon-reload
wgadmin ALL=(root) NOPASSWD: /bin/systemctl enable --now sstp-firewall
wgadmin ALL=(root) NOPASSWD: /bin/systemctl disable --now sstp-firewall
wgadmin ALL=(root) NOPASSWD: /bin/systemctl is-active sstp-firewall
wgadmin ALL=(root) NOPASSWD: /bin/systemctl is-enabled sstp-firewall
wgadmin ALL=(root) NOPASSWD: /usr/bin/test -f /etc/systemd/system/sstp-firewall.service
wgadmin ALL=(root) NOPASSWD: /bin/rm -f /etc/systemd/system/sstp-firewall.service
wgadmin ALL=(root) NOPASSWD: /usr/sbin/nft *
wgadmin ALL=(root) NOPASSWD: /usr/bin/install -d /etc/nftables.d
wgadmin ALL=(root) NOPASSWD: /usr/bin/install -m 644 /tmp/sstp-singbox-*.nft /etc/nftables.d/sstp-singbox.nft
wgadmin ALL=(root) NOPASSWD: /usr/bin/install -m 644 /tmp/sstp-singbox-route-*.service /etc/systemd/system/sstp-singbox-route.service
wgadmin ALL=(root) NOPASSWD: /bin/systemctl enable --now sstp-singbox-route
wgadmin ALL=(root) NOPASSWD: /bin/systemctl disable --now sstp-singbox-route
wgadmin ALL=(root) NOPASSWD: /bin/systemctl is-active sstp-singbox-route
wgadmin ALL=(root) NOPASSWD: /bin/systemctl is-enabled sstp-singbox-route
wgadmin ALL=(root) NOPASSWD: /usr/bin/test -f /etc/nftables.d/sstp-singbox.nft
